<?xml version="1.0" encoding="utf-8"?>
<!--
  Registers sitecore_run_powershell. Deploy only to an instance with Sitecore PowerShell Extensions,
  and only where remote script execution over MCP is acceptable (it can change anything). The tool is
  visible only to an administrator client with writes allowed.
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <sitecoreMcp>
      <tools>
        <tool type="SitecoreMcp.Extensions.Spe.RunPowerShellTool, SitecoreMcp.Extensions.Spe" />
      </tools>
    </sitecoreMcp>
  </sitecore>
</configuration>
